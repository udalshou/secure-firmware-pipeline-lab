[Unit]
Description=Lab appliance API and web UI
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/opt/lab-api/bin/lab-api
Environment=LAB_API_HOST=0.0.0.0 LAB_API_PORT=8080 LAB_UI_DIR=/usr/share/lab-ui
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
Restart=on-failure

[Install]
WantedBy=multi-user.target
