# Root filesystem of the lab appliance: minimal Debian + systemd + lab-api
# serving the web UI. Built with `os/build-rootfs.sh`, which exports the final
# stage as a tarball; the image is never run as a container in production.
#
# Pins: base images by digest, Debian packages via a dated snapshot of the
# archive, Python packages via api/uv.lock (hash-checked).

ARG DEBIAN_IMAGE=debian:trixie-slim@sha256:8aa5a7bf5a1955bddbe7d74fcdd0b91ab30e74362a8b73af672b0481b35b44a0
ARG UV_IMAGE=astral/uv:0.10.12@sha256:72ab0aeb448090480ccabb99fb5f52b0dc3c71923bffb5e2e26517a1c27b7fec

FROM ${UV_IMAGE} AS uv

# --- Shared base: Debian pinned to one archive snapshot ---------------------
FROM ${DEBIAN_IMAGE} AS base
ARG DEBIAN_SNAPSHOT=20261120T000000Z
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN printf 'Types: deb\nURIs: http://snapshot.debian.org/archive/debian/%s\nSuites: trixie trixie-updates\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\n\nTypes: deb\nURIs: http://snapshot.debian.org/archive/debian-security/%s\nSuites: trixie-security\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\n' \
        "${DEBIAN_SNAPSHOT}" "${DEBIAN_SNAPSHOT}" > /etc/apt/sources.list.d/debian.sources \
    && echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/10snapshot

# --- Build the API virtualenv against the target's system Python -----------
FROM base AS api-build
# Package versions are fixed by DEBIAN_SNAPSHOT, not per package.
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=uv /uv /usr/local/bin/uv
# Set by build-rootfs.sh; makes compiled .pyc files hash-based, not dated.
ARG SOURCE_DATE_EPOCH
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH} \
    UV_PROJECT_ENVIRONMENT=/opt/lab-api \
    UV_PYTHON=/usr/bin/python3 \
    UV_PYTHON_DOWNLOADS=never \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy
WORKDIR /src
COPY api/pyproject.toml api/uv.lock api/.python-version ./
RUN uv sync --locked --no-dev --no-install-project
COPY api/src ./src
RUN uv sync --locked --no-dev --no-editable

# --- Final root filesystem ----------------------------------------------------
FROM base AS rootfs
# Package versions are fixed by DEBIAN_SNAPSHOT, not per package.
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends systemd systemd-sysv python3 \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/*.bin /var/log/apt /var/log/dpkg.log
COPY --from=api-build /opt/lab-api /opt/lab-api
COPY ui/dist /usr/share/lab-ui
COPY os/rootfs-overlay/ /
RUN systemctl enable lab-api.service \
    && echo lab-appliance > /etc/hostname \
    && : > /etc/machine-id
