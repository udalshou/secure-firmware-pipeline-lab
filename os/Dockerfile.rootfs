# Root filesystem of the lab appliance: minimal Debian + systemd + lab-api
# serving the web UI. Built with `os/build-rootfs.sh`, which exports the final
# stage as a tarball; the image is never run as a container in production.
#
# Pins: base images by digest, Debian packages via a dated snapshot of the
# archive, Python packages via api/uv.lock (hash-checked). Images are named in
# FROM lines directly (not through ARGs) so Dependabot can bump the digests.

FROM astral/uv:0.13.9@sha256:d3b601f0c7b118bc1753febf7c41cc80981df678445e0254284eecf84db79a7d AS uv

# --- Shared base: Debian pinned to one archive snapshot ---------------------
FROM debian:trixie-slim@sha256:8aa5a7bf5a1955bddbe7d74fcdd0b91ab30e74362a8b73af672b0481b35b44a0 AS base
ARG DEBIAN_SNAPSHOT=20261127T000000Z
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
# The upgrade brings packages preinstalled in the base image to the snapshot's
# versions, so DEBIAN_SNAPSHOT alone decides every package version, including
# security fixes released after the base image was built.
RUN printf 'Types: deb\nURIs: http://snapshot.debian.org/archive/debian/%s\nSuites: trixie trixie-updates\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\n\nTypes: deb\nURIs: http://snapshot.debian.org/archive/debian-security/%s\nSuites: trixie-security\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\n' \
        "${DEBIAN_SNAPSHOT}" "${DEBIAN_SNAPSHOT}" > /etc/apt/sources.list.d/debian.sources \
    && echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/10snapshot \
    && apt-get update \
    && apt-get upgrade -y \
    && rm -rf /var/lib/apt/lists/*

# --- Build the API virtualenv against the target's system Python -----------
FROM base AS api-build
# Package versions are fixed by DEBIAN_SNAPSHOT, not per package.
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=uv /uv /usr/local/bin/uv
# Set by build-rootfs.sh; makes compiled .pyc files hash-based, not dated.
ARG SOURCE_DATE_EPOCH
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH} \
    UV_PROJECT_ENVIRONMENT=/opt/lab-api \
    UV_PYTHON=/usr/bin/python3 \
    UV_PYTHON_DOWNLOADS=never \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy
WORKDIR /src
COPY api/pyproject.toml api/uv.lock api/.python-version ./
RUN uv sync --locked --no-dev --no-install-project
COPY api/src ./src
RUN uv sync --locked --no-dev --no-editable

# --- Final root filesystem ----------------------------------------------------
FROM base AS rootfs
# Package versions are fixed by DEBIAN_SNAPSHOT, not per package.
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends systemd systemd-sysv systemd-timesyncd python3 \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/*.bin /var/log/apt /var/log/dpkg.log
COPY --from=api-build /opt/lab-api /opt/lab-api
COPY ui/dist /usr/share/lab-ui
COPY os/rootfs-overlay/ /
# Hardening (docs/hardening-review.md):
# - only lab-api and time sync run; apt timers and cron scripts are pointless
#   on an image updated as a whole by Mender (there is no cron daemon either),
#   and no network file systems are mounted
# - no console logins: every account is locked, so gettys only add surface
# - no setuid/setgid programs: nobody logs in, so nothing needs to elevate
# - new files are not world-readable by default (trixie's login.defs has
#   no UMASK line)
RUN systemctl enable lab-api.service systemd-timesyncd.service \
    && systemctl disable apt-daily.timer apt-daily-upgrade.timer dpkg-db-backup.timer \
        remote-fs.target getty@tty1.service \
    && systemctl mask getty@.service autovt@.service serial-getty@.service \
    && rm -rf /etc/cron.daily \
    && find / -xdev -type f -perm /6000 -exec chmod ug-s {} + \
    && printf 'UMASK\t\t027\n' >> /etc/login.defs \
    && echo lab-appliance > /etc/hostname \
    && : > /etc/machine-id
